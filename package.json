{
  "name": "probe.ts",
  "version": "0.0.0",
  "description": "Testframework für discord.js-Bots – mockt nur den Transport-Layer (@discordjs/ws / @discordjs/rest), nie die Models.",
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "testing",
    "test-framework",
    "vitest",
    "mock"
  ],
  "author": "GalaxyBotTeam",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "discord.js": "^14.16.3"
  },
  "dependencies": {
    "@discordjs/collection": "^2.1.1",
    "@discordjs/rest": "^2.4.0",
    "@discordjs/ws": "^1.1.1",
    "discord-api-types": "^0.38.55"
  },
  "overrides": {
    "@discordjs/collection": "$@discordjs/collection",
    "discord-api-types": "$discord-api-types"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "discord.js": "^14.16.3",
    "eslint": "^9.15.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0",
    "vitest": "^2.1.8"
  }
}
